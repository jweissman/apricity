# flyctl launch added from .gitignore
.bundle
.yardoc
_yardoc
coverage
doc
pkg
spec/reports
tmp
log
vendor
example/*/vendor
artifacts
**/.apricity

# rspec failure tracking
**/.rspec_status
**/bom.xml

# flyctl launch added from .ruby-lsp/.gitignore
.ruby-lsp/**/*

# flyctl launch added from example/blog/.gitignore
# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
example/blog/.bundle

# Ignore all environment files.
example/blog/.env*

# Ignore all logfiles and tempfiles.
example/blog/log/*
example/blog/tmp/*
!example/blog/log/.keep
!example/blog/tmp/.keep

# Ignore pidfiles, but keep the directory.
example/blog/tmp/pids/*
!example/blog/tmp/pids
!example/blog/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
example/blog/storage/*
!example/blog/storage/.keep
example/blog/tmp/storage/*
!example/blog/tmp/storage
!example/blog/tmp/storage/.keep

example/blog/public/assets

# Ignore key files for decrypting credentials and more.
example/blog/config/*.key


