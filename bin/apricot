#!/usr/bin/env ruby
# frozen_string_literal: true

require "bundler/setup"
require "yaml"
require "debug"
require "apricity"
require "apricity/pipeline_parser"
require "apricity/cli/apricot"

# Autobind current directory
Apricity.configure do |config|
  config.bind_mounts << Apricity::Model::Mount[".", "/work/app", :bind]
end

git_sha = `git rev-parse HEAD`.chomp
file = ARGV.shift
pipeline = Apricity::Model::Pipeline.from_yaml(File.read(file))
apricot = Apricity::CLI::Apricot.new
apricot.monitor_execution(pipeline:, git_sha:)
