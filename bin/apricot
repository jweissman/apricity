#!/usr/bin/env ruby
# frozen_string_literal: true

require "bundler/setup"
require "yaml"
require "debug"
require "apricity"
require "apricity/pipeline/parser"
require "apricity/cli/apricot"

Apricity.register_default_plugins
Apricity.register_default_actions

# ENV["APRICITY_HOST_ARTIFACT_ROOT"] ||= File.join(Dir.pwd, ".apricity")

# nicer options parsing
require "optparse"
options = {}
OptionParser.new do |opts|
  opts.banner = "Usage: apricot [options] <pipeline-file>"

  opts.on("-v", "--verbose", "Enable verbose output") do
    options[:verbose] = true
  end

  opts.on("-h", "--help", "Prints this help") do
    puts opts
    exit
  end
end.parse!
file = ARGV.last || "apricity.yaml"


puts "Loading pipeline from #{file} with options: #{options}" if options[:verbose]

git_sha = `git rev-parse HEAD`.chomp
pipeline = Apricity::Model::Pipeline.from_file(file)
apricot = Apricity::CLI::Apricot.new
apricot.monitor_execution(pipeline:, git_sha:, options:)
