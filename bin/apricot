#!/usr/bin/env ruby
# frozen_string_literal: true

require "bundler/setup"
require "yaml"
require "debug"
require "apricity"
require "apricity/pipeline/parser"
require "apricity/cli/apricot"

# Autobind current directory?
# Apricity.configure do |config|
#   config.bind_mounts << Apricity::Model::Mount[".", "/work/app", :bind]
# end

Apricity.register_default_plugins

file = ARGV.first || "apricity.yaml"
options = {}
options[:verbose] = true if ARGV.include?("--verbose")
git_sha = `git rev-parse HEAD`.chomp
pipeline = Apricity::Model::Pipeline.from_file(file)
apricot = Apricity::CLI::Apricot.new
apricot.monitor_execution(pipeline:, git_sha:, options:)
