<!-- Quick Start -->
<div class="bg-white rounded-xl border border-frost-200 p-6 mb-8">
  <h2 class="text-xl font-semibold text-frost-800 mb-6 flex items-center gap-2">
    <i class="fas fa-rocket text-sun-500"></i>
    Quick Start
  </h2>
  
  <div class="space-y-6">
    <div>
      <h3 class="text-sm font-semibold text-frost-700 mb-3">1. Installation</h3>
      <div class="bg-frost-900 rounded-lg p-4 text-frost-100 font-mono text-sm overflow-x-auto">
        <div class="mb-2"><span class="text-frost-500"># Install via RubyGems</span></div>
        <div>gem install apricity</div>
      </div>
    </div>

    <div>
      <h3 class="text-sm font-semibold text-frost-700 mb-3">2. Create a pipeline file</h3>
      <p class="text-sm text-frost-600 mb-3">Create <code class="px-2 py-1 bg-frost-100 text-frost-800 rounded text-xs font-mono">apricity.yaml</code> in your project root:</p>
      <div class="bg-frost-900 rounded-lg p-4 text-frost-100 font-mono text-sm overflow-x-auto">
        <pre class="text-xs leading-relaxed">name: My Pipeline
actions:
  build:
    jobs:
      - test:
          runs-on: ruby:3.4
          name: Run Tests
          mounts:
            - source: .
              target: /work
              type: bind
          steps:
            - name: Install dependencies
              run: bundle install
            - name: Run tests
              run: bundle exec rspec</pre>
      </div>
    </div>

    <div>
      <h3 class="text-sm font-semibold text-frost-700 mb-3">3. Run the pipeline</h3>
      <div class="bg-frost-900 rounded-lg p-4 text-frost-100 font-mono text-sm overflow-x-auto">
        <div class="mb-2"><span class="text-frost-500"># Using the CLI</span></div>
        <div class="mb-3">apricot apricity.yaml</div>
        <div class="mb-2"><span class="text-frost-500"># Or start the web dashboard</span></div>
        <div>bin/server</div>
      </div>
    </div>
  </div>
</div>

<!-- Pipeline Configuration -->
<div class="bg-white rounded-xl border border-frost-200 p-6 mb-8">
  <h2 class="text-xl font-semibold text-frost-800 mb-6 flex items-center gap-2">
    <i class="fas fa-cog text-sun-500"></i>
    Pipeline Configuration
  </h2>

  <div class="space-y-6">
    <div>
      <h3 class="text-base font-semibold text-frost-700 mb-3">Basic Structure</h3>
      <div class="bg-frost-900 rounded-lg p-4 text-frost-100 font-mono text-xs overflow-x-auto">
        <pre class="leading-relaxed">name: Pipeline Name
actions:
  action_name:
    jobs:
      - job_name:
          runs-on: image:tag      <span class="text-frost-500"># Docker image</span>
          name: Human-readable name
          needs: [other_job]      <span class="text-frost-500"># Dependencies</span>
          mounts: [...]           <span class="text-frost-500"># Bind mounts</span>
          steps: [...]            <span class="text-frost-500"># Execution steps</span>
          inputs: [...]           <span class="text-frost-500"># Input artifacts/values</span>
          outputs: [...]          <span class="text-frost-500"># Output artifacts/values</span>
          conditions: [...]       <span class="text-frost-500"># Conditional execution</span>
          plugins: [...]          <span class="text-frost-500"># Plugin hooks</span>
          strategy:               <span class="text-frost-500"># Matrix builds</span>
            matrix:
              key: [val1, val2]</pre>
      </div>
    </div>

    <div>
      <h3 class="text-base font-semibold text-frost-700 mb-3">Artifacts</h3>
      <p class="text-sm text-frost-600 mb-3">Pass files between jobs:</p>
      <div class="bg-frost-900 rounded-lg p-4 text-frost-100 font-mono text-xs overflow-x-auto">
        <pre class="leading-relaxed"><span class="text-frost-500"># Producer job</span>
outputs:
  - key: test-results
    type: artifact

<span class="text-frost-500"># Consumer job</span>
inputs:
  - key: test-results
    type: artifact
needs: [producer_job]</pre>
      </div>
    </div>

    <div>
      <h3 class="text-base font-semibold text-frost-700 mb-3">Matrix Builds</h3>
      <p class="text-sm text-frost-600 mb-3">Fan out jobs across multiple configurations:</p>
      <div class="bg-frost-900 rounded-lg p-4 text-frost-100 font-mono text-xs overflow-x-auto">
        <pre class="leading-relaxed">strategy:
  matrix:
    ruby: ["3.2", "3.3", "3.4"]
    os: [ubuntu, alpine]</pre>
      </div>
      <p class="text-sm text-frost-500 mt-2 italic">This creates 6 jobs (3 × 2), each with MATRIX_RUBY and MATRIX_OS environment variables.</p>
    </div>

    <div>
      <h3 class="text-base font-semibold text-frost-700 mb-3">Plugins</h3>
      <p class="text-sm text-frost-600 mb-3">Attach plugins to jobs for reporting and analysis:</p>
      <div class="bg-frost-900 rounded-lg p-4 text-frost-100 font-mono text-xs overflow-x-auto">
        <pre class="leading-relaxed">plugins:
  - uses: apricity/junit-reporter
    with:
      junit_report: rspec.xml
      artifact_key: test-outputs
  - uses: apricity/simplecov-reporter
    with:
      artifact_key: coverage
  - uses: apricity/sbom-reporter
    with:
      artifact_key: sbom</pre>
      </div>
    </div>
  </div>
</div>

