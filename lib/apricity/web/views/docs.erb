<!-- Architecture -->
<div class="bg-white rounded-xl border border-frost-200 p-6 mb-8">
  <h2 class="text-xl font-semibold text-frost-800 mb-6 flex items-center gap-2">
    <i class="fas fa-sitemap text-sun-500"></i>
    Architecture
  </h2>
  <div class="bg-frost-900 rounded-lg p-6 text-frost-100 font-mono text-xs overflow-x-auto">
    <pre class="leading-relaxed">┌─────────────────────────────────────────────────────────────┐
│                        Apricity                              │
├─────────────────────────────────────────────────────────────┤
│  CLI (Apricot)          │  Web UI (April)                   │
│  └─ TUI Renderer        │  └─ Sinatra + HTMX + SSE          │
├─────────────────────────────────────────────────────────────┤
│                     Run / EventStore                         │
│              (Event-sourced state management)                │
├─────────────────────────────────────────────────────────────┤
│  Pipeline               │  JobExecution                      │
│  ├─ Parser (YAML)       │  ├─ Orchestrator                   │
│  ├─ Reducer (→ Nodes)   │  ├─ Planner                        │
│  ├─ Graph (DAG)         │  ├─ StepExecutor                   │
│  └─ Runner (Scheduler)  │  └─ Collector                      │
├─────────────────────────────────────────────────────────────┤
│                      Plugin System                           │
│               (Event-driven hooks)                           │
├─────────────────────────────────────────────────────────────┤
│                     Model Layer                              │
│  (Pipeline, Action, Job, Step, Input, Output, etc.)         │
├─────────────────────────────────────────────────────────────┤
│                     Docker API                               │
└─────────────────────────────────────────────────────────────┘</pre>
  </div>
</div>

