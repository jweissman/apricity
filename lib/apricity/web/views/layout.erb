<!DOCTYPE html>

<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Apricity CI</title>

    <!-- Dynamic favicon - updated by JS based on build status -->
    <link id="favicon" rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><circle cx='50' cy='50' r='40' fill='%23c9a227'/></svg>">

    <%= erb :head, layout: false %>
    <script src="https://unpkg.com/htmx.org@1.6.1"></script>
    <script src="https://cdn.jsdelivr.net/npm/mermaid@11.12.2/dist/mermaid.min.js"></script>
  </head>

  <body class="min-h-screen flex flex-col bg-frost-50">
    <header class="bg-white border-b border-frost-200 sticky top-0 z-50 shadow-sm">
      <div class="max-w-7xl mx-auto px-6 py-3.5 flex items-center justify-between">
        <a href="/" class="flex items-center space-x-3 group">
          <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-sun-400 to-sun-600 flex items-center justify-center shadow-sm transition-transform group-hover:scale-105">
            <i class="fas fa-sun text-white text-base"></i>
          </div>
          <span class="text-lg font-semibold text-frost-800 group-hover:text-sun-700 transition-colors">Apricity</span>
        </a>
        <nav class="flex items-center text-sm space-x-1">
          <a href="/" class="nav-link <%= request.path_info == '/' ? 'active bg-sun-50 text-sun-700' : 'text-frost-600 hover:text-sun-600 hover:bg-sun-50/50' %> transition-all px-4 py-2 rounded-lg font-medium">
            <i class="fas fa-tachometer-alt mr-2 text-xs"></i>
            Dashboard
          </a>
          <a href="/runs" class="nav-link <%= request.path_info.start_with?('/runs') ? 'active bg-sun-50 text-sun-700' : 'text-frost-600 hover:text-sun-600 hover:bg-sun-50/50' %> transition-all px-4 py-2 rounded-lg font-medium">
            <i class="fas fa-clock-rotate-left mr-2 text-xs"></i>
            Activity
          </a>
          <a href="/workers" class="nav-link <%= request.path_info == '/workers' ? 'active bg-sun-50 text-sun-700' : 'text-frost-600 hover:text-sun-600 hover:bg-sun-50/50' %> transition-all px-4 py-2 rounded-lg font-medium">
            <i class="fas fa-server mr-2 text-xs"></i>
            Workers
          </a>
          <div class="w-px h-5 bg-frost-200 mx-1"></div>
          <a href="/docs" class="nav-link <%= request.path_info == '/docs' ? 'active bg-sun-50 text-sun-700' : 'text-frost-600 hover:text-sun-600 hover:bg-sun-50/50' %> transition-all px-4 py-2 rounded-lg font-medium">
            <i class="fas fa-book mr-2 text-xs"></i>
            Docs
          </a>
          <a href="/about" class="nav-link <%= request.path_info == '/about' ? 'active bg-sun-50 text-sun-700' : 'text-frost-600 hover:text-sun-600 hover:bg-sun-50/50' %> transition-all px-4 py-2 rounded-lg font-medium">
            <i class="fas fa-circle-info mr-2 text-xs"></i>
            About
          </a>
        </nav>
      </div>
    </header>

    <main class="flex-grow max-w-7xl mx-auto w-full px-6 py-8">
      <%= yield %>
    </main>

    <footer class="border-t border-frost-200 bg-white text-center py-5 text-xs text-frost-500">
      <p>Apricity CI · Press <kbd class="bg-frost-100 px-2 py-1 rounded text-frost-600 font-mono text-[10px] border border-frost-200">?</kbd> for keyboard shortcuts</p>
    </footer>

    <script src="/assets/keyboard.js"></script>
    <script src="/assets/filter.js"></script>
    
    <script>
      mermaid.initialize({ 
        startOnLoad: false,
        theme: 'base',
        themeVariables: {
          primaryColor: '#f8f9fb',
          primaryTextColor: '#3d4a5c',
          primaryBorderColor: '#e8c75e',
          lineColor: '#e2e7ef',
          secondaryColor: '#f8f9fb',
          tertiaryColor: '#ffffff',
          fontSize: '12px',
          fontFamily: 'system-ui, -apple-system, BlinkMacSystemFont, sans-serif'
        },
        flowchart: {
          curve: 'basis',
          padding: 18,
          nodeSpacing: 65,
          rankSpacing: 75,
          htmlLabels: true,
          useMaxWidth: false,
          wrappingWidth: 220
        }
      });
    </script>
  </body>
</html>
