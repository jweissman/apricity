<!DOCTYPE html>

<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Apricity Dashboard</title>

    <link
      href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css"
      rel="stylesheet"
    >
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    >
    <link
      href="https://cdn.jsdelivr.net/npm/xterm@5.3.0/css/xterm.min.css"
      rel="stylesheet"
    >
    <script src="https://cdn.jsdelivr.net/npm/xterm-addon-fit/lib/xterm-addon-fit.js"></script>
    <script src="https://unpkg.com/htmx.org@1.6.1"></script>
    <script src="https://cdn.jsdelivr.net/npm/xterm@5.3.0/lib/xterm.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/mermaid@11.12.2/dist/mermaid.min.js"></script>

    <style>
      /* Custom scrollbar */
      ::-webkit-scrollbar { width: 8px; height: 8px; }
      ::-webkit-scrollbar-track { background: #f3f4f6; }
      ::-webkit-scrollbar-thumb { background: #d1d5db; border-radius: 4px; }
      ::-webkit-scrollbar-thumb:hover { background: #9ca3af; }

      /* Terminal keeps dark scrollbar */
      .terminal-output::-webkit-scrollbar-track { background: #111827; }
      .terminal-output::-webkit-scrollbar-thumb { background: #4b5563; }
      .terminal-output::-webkit-scrollbar-thumb:hover { background: #6b7280; }

      /* Smooth transitions */
      .transition-all { transition: all 0.2s ease-in-out; }

      /* Card hover effects */
      .card-hover:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(59, 130, 246, 0.15);
      }

      /* Gradient border effect */
      .gradient-border {
        position: relative;
      }
      .gradient-border::before {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: inherit;
        padding: 1px;
        background: linear-gradient(135deg, #3b82f6, #8b5cf6);
        -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
        mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
        -webkit-mask-composite: xor;
        mask-composite: exclude;
      }

      /* Pulsing animation for running state */
      @keyframes pulse-subtle {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.7; }
      }
      .animate-pulse-subtle { animation: pulse-subtle 2s infinite; }

      /* Terminal-like output styling */
      .terminal-output {
        font-family: 'Monaco', 'Menlo', 'Ubuntu Mono', monospace;
        font-size: 12px;
        line-height: 1.4;
      }

      /* DAG container styling */
      #dag-container {
        min-height: 200px;
        padding: 32px 24px;
        background: linear-gradient(to bottom, #fafafa 0%, #ffffff 100%);
        border-radius: 12px;
      }

      /* Mermaid SVG enhancements */
      #dag-container svg {
        max-width: 100%;
        height: auto;
        filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.05));
      }

      /* Force stadium nodes to be wider */
      #dag-container .node rect {
        rx: 20px !important;
        ry: 20px !important;
      }

      /* Keyboard shortcuts help */
      .keyboard-shortcuts {
        position: fixed;
        bottom: 20px;
        right: 20px;
        background: rgba(17, 24, 39, 0.95);
        backdrop-filter: blur(8px);
        color: white;
        padding: 16px 20px;
        border-radius: 12px;
        font-size: 13px;
        z-index: 1000;
        display: none;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
        border: 1px solid rgba(255, 255, 255, 0.1);
        min-width: 220px;
      }
      .keyboard-shortcuts.visible { 
        display: block;
        animation: slideIn 0.15s ease-out;
      }
      @keyframes slideIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
      }
      .keyboard-shortcuts kbd {
        background: rgba(255, 255, 255, 0.15);
        padding: 3px 8px;
        border-radius: 4px;
        font-family: system-ui, -apple-system, sans-serif;
        font-size: 11px;
        font-weight: 500;
        border: 1px solid rgba(255, 255, 255, 0.2);
      }

      /* Sidebar collapse */
      .job-sidebar.collapsed {
        width: 48px;
      }
      .job-sidebar.collapsed .sidebar-content {
        display: none;
      }
      
      /* Responsive improvements */
      @media (max-width: 768px) {
        .job-sidebar {
          width: 100%;
          border-right: none;
          border-bottom: 1px solid #e5e7eb;
          padding-bottom: 1rem;
        }
        .flex.gap-6 {
          flex-direction: column;
        }
      }

      /* Make node labels more spacious */
      #dag-container .nodeLabel {
        font-family: system-ui, -apple-system, sans-serif;
        font-weight: 500;
      }

      /* Hover effect on DAG nodes */
      #dag-container .node:hover {
        filter: brightness(1.05);
        cursor: pointer;
      }

      /* Smooth edge rendering */
      #dag-container .edgePath path {
        stroke-width: 2px;
        opacity: 0.7;
      }

      #dag-container .edgePath:hover path {
        opacity: 1;
        stroke-width: 2.5px;
      }

    </style>
  </head>

  <body class="min-h-screen flex flex-col bg-gray-50">
    <header class="bg-white backdrop-blur-sm border-b border-gray-200 sticky top-0 z-50 shadow-sm">
      <div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between">
        <a href="/" class="flex items-center space-x-3 group">
          <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-blue-500 to-indigo-600 flex items-center justify-center shadow-lg shadow-blue-500/20 group-hover:shadow-blue-500/40 group-hover:scale-105 transition-all">
            <i class="fas fa-snowflake text-white text-sm"></i>
          </div>
          <h1 class="text-xl font-bold bg-gradient-to-r from-blue-600 to-indigo-600 text-transparent bg-clip-text">
            Apricity CI
          </h1>
        </a>
        <nav class="flex items-center space-x-4 text-sm">
          <a href="/" class="text-gray-500 hover:text-gray-900 transition-colors px-3 py-1.5 rounded-lg hover:bg-gray-100">
            <i class="fas fa-home mr-1.5"></i> Dashboard
          </a>
        </nav>
      </div>
    </header>

    <main class="flex-grow max-w-7xl mx-auto w-full px-4 py-6">
      <%= yield %>
    </main>

    <footer class="bg-white border-t border-gray-200 text-center py-3 text-xs text-gray-400">
      <p>&copy; <script>document.write(new Date().getFullYear())</script> Oddball Inc &middot; Apricity CI <span class="text-gray-300 mx-2">|</span> Press <kbd class="bg-gray-100 px-1.5 py-0.5 rounded text-gray-600 font-mono text-xs">?</kbd> for shortcuts</p>
    </footer>

    <script src="/assets/keyboard.js"></script>
    <script src="/assets/filter.js"></script>
    
    <script>
      mermaid.initialize({ 
        startOnLoad: false,
        theme: 'base',
        themeVariables: {
          primaryColor: '#eff6ff',
          primaryTextColor: '#1f2937',
          primaryBorderColor: '#93c5fd',
          lineColor: '#cbd5e1',
          secondaryColor: '#f8fafc',
          tertiaryColor: '#ffffff',
          fontSize: '13px',
          fontFamily: 'system-ui, -apple-system, sans-serif'
        },
        flowchart: {
          curve: 'basis',
          padding: 10,
          nodeSpacing: 50,
          rankSpacing: 80,
          htmlLabels: true,
          useMaxWidth: true
        }
      });
    </script>
  </body>
</html>
