<div class="mb-6">
  <a href="/" class="text-sm text-gray-500 hover:text-gray-700 transition-colors">
    <i class="fas fa-arrow-left mr-2"></i>Back to Dashboard
  </a>
</div>

<div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6 mb-6">
  <div class="flex items-center justify-between">
    <div>
      <h2 class="text-2xl font-bold text-gray-900"><%= @pipeline.name %></h2>
      <p class="text-sm text-gray-500 mt-1">
        <%= @pipeline.actions.size %> action<%= @pipeline.actions.size != 1 ? 's' : '' %> &middot;
        <%= @pipeline.total_steps %> steps
      </p>
    </div>
    <form action="/pipelines/<%= @pipeline.slug %>/run" method="post">
      <input type="hidden" name="pipeline_slug" value="<%= @pipeline.slug %>">
      <button
        type="submit"
        class="inline-flex items-center px-4 py-2 bg-green-500 hover:bg-green-600 text-white font-medium rounded-lg transition-colors shadow-md hover:shadow-lg"
      >
        <i class="fas fa-play mr-2 text-sm"></i>
        Start New Run
      </button>
    </form>
  </div>
</div>

<!-- Pipeline DAG Structure -->
<div class="mb-6 bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
  <div class="px-6 py-4 border-b border-gray-100 bg-gradient-to-r from-blue-50 to-indigo-50">
    <h3 class="text-sm font-semibold text-gray-700 uppercase tracking-wide flex items-center">
      <i class="fas fa-project-diagram mr-2 text-blue-500"></i>
      Pipeline Structure
    </h3>
  </div>
  <div id="dag-container" class="flex justify-center p-4"></div>
</div>

<script>
  window.PipelineDag = <%= dag_data(@pipeline) %>;
</script>
<script>
  // Render static DAG (no job status, just structure)
  document.addEventListener('DOMContentLoaded', async () => {
    const dag = window.PipelineDag;
    if (!dag || !dag.nodes) return;
    
    const lines = ["graph LR"];
    dag.nodes.forEach(node => {
      const safe = node.id.replace(/::/g, "_").replace(/[\[\]=,\s]+/g, "_");
      const label = node.label.replace(/_/g, " ").replace(/\b\w/g, c => c.toUpperCase());
      lines.push(`  ${safe}([○ ${label}])`);
      lines.push(`  style ${safe} fill:#f8fafc,stroke:#cbd5e1,stroke-width:2px`);
    });
    dag.edges.forEach(edge => {
      const from = edge.from.replace(/::/g, "_").replace(/[\[\]=,\s]+/g, "_");
      const to = edge.to.replace(/::/g, "_").replace(/[\[\]=,\s]+/g, "_");
      lines.push(`  ${from} --> ${to}`);
    });
    
    const container = document.getElementById('dag-container');
    try {
      const { svg } = await mermaid.render('pipeline-dag', lines.join("\n"));
      container.innerHTML = svg;
    } catch (e) {
      console.error("Mermaid render error:", e);
      container.innerHTML = `<p class="text-gray-400 text-sm">Unable to render diagram</p>`;
    }
  });
</script>

<div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">
  <h3 class="text-lg font-semibold text-gray-900 mb-4 flex items-center">
    <i class="fas fa-history mr-3 text-indigo-500"></i>
    Run History
  </h3>
  <div
    hx-get="/pipelines/<%= @pipeline.slug %>/runs"
    hx-trigger="load"
    hx-target="#job-list"
    hx-swap="innerHTML"
  ></div>
  <div id="job-list">
    <div class="text-center py-8 text-gray-400">
      <i class="fas fa-spinner fa-spin mr-2"></i>
      Loading runs...
    </div>
  </div>
</div>
