<section class="space-y-8">
  <!-- Pipelines Section -->
  <div class="bg-white rounded-xl border border-frost-200 p-6">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-base font-semibold text-frost-800 flex items-center gap-2">
        <i class="fas fa-diagram-project text-sun-500"></i>
        Pipelines
      </h2>
      <span class="text-xs text-frost-500 bg-frost-100 px-2.5 py-1 rounded-full font-medium"><%= @pipelines.size %> configured</span>
    </div>

    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      <% @pipelines.each do |pipeline| %>
        <div class="group relative bg-frost-50/50 hover:bg-white rounded-lg border border-frost-200 hover:border-sun-300 p-5 transition-all duration-200">
          <div class="flex items-start justify-between mb-4">
            <div class="flex-1 min-w-0">
              <h3 class="font-medium text-frost-800 group-hover:text-sun-700 transition-colors truncate"><%= pipeline.name %></h3>
              <p class="text-xs text-frost-500 mt-1.5">
                <%= pipeline.actions.size %> action<%= pipeline.actions.size != 1 ? 's' : '' %> · <%= pipeline.total_steps %> steps
              </p>
            </div>
            <form action="/pipelines/<%= pipeline.slug %>/run" method="post" class="inline run-form">
              <button 
                type="submit" 
                class="run-button w-9 h-9 rounded-lg bg-sun-500 hover:bg-sun-600 text-white flex items-center justify-center transition-colors shadow-sm cursor-pointer"
                title="Run pipeline"
              >
                <i class="fas fa-play text-xs"></i>
              </button>
            </form>
          </div>
          <a href="/pipelines/<%= pipeline.slug %>" class="text-sm text-sun-600 hover:text-sun-700 font-medium transition-colors">
            View details →
          </a>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Recent Runs Section -->
  <div class="bg-white rounded-xl border border-frost-200 p-6">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-base font-semibold text-frost-800 flex items-center gap-2">
        <i class="fas fa-clock-rotate-left text-frost-400"></i>
        Recent Runs
      </h2>
      <select id="status-filter" class="text-sm border border-frost-200 rounded-lg px-3 py-1.5 bg-white focus:ring-2 focus:ring-sun-500/20 focus:border-sun-400 transition-all text-frost-600">
        <option value="all">All Status</option>
        <option value="running">Running</option>
        <option value="success">Passed</option>
        <option value="failure">Failed</option>
      </select>
    </div>

    <div
      hx-get="/runs"
      hx-trigger="load"
      hx-target="#job-list"
      hx-swap="innerHTML"
    ></div>

    <div id="job-list">
      <!-- Loading skeleton -->
      <div class="space-y-2">
        <div class="h-16 bg-frost-100 rounded-xl animate-pulse"></div>
        <div class="h-16 bg-frost-100 rounded-xl animate-pulse"></div>
        <div class="h-16 bg-frost-100 rounded-xl animate-pulse"></div>
      </div>
    </div>
  </div>
</section>
