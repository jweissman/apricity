<section class="space-y-8">
  <!-- Pipelines Section -->
  <div class="bg-white rounded-xl border border-frost-200 p-6">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-base font-semibold text-frost-800 flex items-center gap-2">
        <i class="fas fa-diagram-project text-sun-500"></i>
        Pipelines
      </h2>
      <span class="text-xs text-frost-500 bg-frost-100 px-2.5 py-1 rounded-full font-medium"><%= @pipelines.size %> configured</span>
    </div>

    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      <% @pipelines.each do |pipeline| %>
        <div class="group relative bg-frost-50/50 hover:bg-white rounded-lg border border-frost-200 hover:border-sun-300 p-5 transition-all duration-200">
          <div class="flex items-start justify-between mb-4">
            <div class="flex-1 min-w-0">
              <h3 class="font-medium text-frost-800 group-hover:text-sun-700 transition-colors truncate"><%= pipeline.name %></h3>
              <p class="text-xs text-frost-500 mt-1.5">
                <%= pipeline.actions.size %> action<%= pipeline.actions.size != 1 ? 's' : '' %> · <%= pipeline.total_steps %> steps
              </p>
            </div>
            <form action="/pipelines/<%= pipeline.slug %>/run" method="post" class="inline run-form">
              <button 
                type="submit" 
                class="run-button w-9 h-9 rounded-lg bg-sun-500 hover:bg-sun-600 text-white flex items-center justify-center transition-colors shadow-sm cursor-pointer"
                title="Run pipeline"
              >
                <i class="fas fa-play text-xs"></i>
              </button>
            </form>
          </div>
          <a href="/pipelines/<%= pipeline.slug %>" class="text-sm text-sun-600 hover:text-sun-700 font-medium transition-colors">
            View details →
          </a>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Recent Runs Section -->
  <div class="bg-white rounded-xl border border-frost-200 p-6">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-base font-semibold text-frost-800 flex items-center gap-2">
        <i class="fas fa-clock-rotate-left text-frost-400"></i>
        Recent Runs
      </h2>
      <div class="flex items-center gap-3">
        <select id="status-filter" class="text-sm border border-frost-200 rounded-lg px-3 py-1.5 bg-white focus:ring-2 focus:ring-sun-500/20 focus:border-sun-400 transition-all text-frost-600">
          <option value="all">All Status</option>
          <option value="running">Running</option>
          <option value="success">Passed</option>
          <option value="failure">Failed</option>
        </select>
        <a href="/runs" class="text-xs font-medium text-sun-600 hover:text-sun-700 hover:underline">
          View All History →
        </a>
      </div>
    </div>

    <div
      hx-get="/runs?limit=10&partial=true"
      hx-trigger="load"
      hx-target="#job-list"
      hx-swap="innerHTML"
    ></div>

    <div id="job-list">
      <!-- Loading skeleton with better visual structure -->
      <div class="space-y-3">
        <div class="animate-pulse p-4 bg-white rounded-xl border border-frost-200">
          <div class="flex items-center gap-4">
            <div class="w-10 h-10 rounded-lg bg-frost-100"></div>
            <div class="flex-1 space-y-2.5">
              <div class="h-4 bg-frost-100 rounded w-2/5"></div>
              <div class="h-3 bg-frost-50 rounded w-1/4"></div>
            </div>
            <div class="space-y-2 text-right">
              <div class="h-3 bg-frost-100 rounded w-24 ml-auto"></div>
              <div class="h-3 bg-frost-50 rounded w-16 ml-auto"></div>
            </div>
          </div>
        </div>
        <div class="animate-pulse p-4 bg-white rounded-xl border border-frost-200">
          <div class="flex items-center gap-4">
            <div class="w-10 h-10 rounded-lg bg-frost-100"></div>
            <div class="flex-1 space-y-2.5">
              <div class="h-4 bg-frost-100 rounded w-1/3"></div>
              <div class="h-3 bg-frost-50 rounded w-1/5"></div>
            </div>
            <div class="space-y-2 text-right">
              <div class="h-3 bg-frost-100 rounded w-24 ml-auto"></div>
              <div class="h-3 bg-frost-50 rounded w-16 ml-auto"></div>
            </div>
          </div>
        </div>
        <div class="animate-pulse p-4 bg-white rounded-xl border border-frost-200">
          <div class="flex items-center gap-4">
            <div class="w-10 h-10 rounded-lg bg-frost-100"></div>
            <div class="flex-1 space-y-2.5">
              <div class="h-4 bg-frost-100 rounded w-1/2"></div>
              <div class="h-3 bg-frost-50 rounded w-1/3"></div>
            </div>
            <div class="space-y-2 text-right">
              <div class="h-3 bg-frost-100 rounded w-24 ml-auto"></div>
              <div class="h-3 bg-frost-50 rounded w-16 ml-auto"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
