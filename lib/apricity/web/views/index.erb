<section class="space-y-8">
  <!-- Pipelines Section -->
  <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-lg font-semibold text-gray-900 flex items-center">
        <i class="fas fa-sitemap mr-3 text-blue-500"></i>
        Pipelines
      </h2>
      <span class="text-xs text-gray-400 bg-gray-100 px-2 py-1 rounded-full"><%= @pipelines.size %> configured</span>
    </div>

    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      <% @pipelines.each do |pipeline| %>
        <div class="bg-gray-50 rounded-lg border border-gray-200 p-4 card-hover transition-all hover:border-blue-300 hover:bg-blue-50/30">
          <div class="flex items-start justify-between mb-3">
            <div>
              <h3 class="font-semibold text-gray-900"><%= pipeline.name %></h3>
              <p class="text-xs text-gray-500 mt-1">
                <%= pipeline.actions.size %> action<%= pipeline.actions.size != 1 ? 's' : '' %> &middot;
                <%= pipeline.total_steps %> steps
              </p>
            </div>
            <form action="/pipelines/<%= pipeline.slug %>/run" method="post" class="inline">
              <button 
                type="submit" 
                class="w-9 h-9 rounded-full bg-green-500 hover:bg-green-600 text-white flex items-center justify-center transition-colors shadow-md hover:shadow-lg"
                title="Run pipeline"
              >
                <i class="fas fa-play text-xs ml-0.5"></i>
              </button>
            </form>
          </div>
          <a
            href="/pipelines/<%= pipeline.slug %>"
            class="text-sm text-blue-600 hover:text-blue-700 font-medium transition-colors"
          >
            View details <i class="fas fa-arrow-right ml-1 text-xs"></i>
          </a>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Recent Runs Section -->
  <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-lg font-semibold text-gray-900 flex items-center">
        <i class="fas fa-history mr-3 text-indigo-500"></i>
        Recent Runs
      </h2>
      <div class="flex items-center space-x-2">
        <select id="status-filter" class="text-sm border border-gray-300 rounded-lg px-3 py-1.5 focus:ring-2 focus:ring-blue-500 focus:border-transparent">
          <option value="all">All Status</option>
          <option value="running">Running</option>
          <option value="success">Passed</option>
          <option value="failure">Failed</option>
        </select>
      </div>
    </div>

    <div
      hx-get="/runs"
      hx-trigger="load"
      hx-target="#job-list"
      hx-swap="innerHTML"
    ></div>

    <div id="job-list">
      <div class="space-y-2 animate-pulse">
        <div class="h-20 bg-gray-100 rounded-lg"></div>
        <div class="h-20 bg-gray-100 rounded-lg"></div>
        <div class="h-20 bg-gray-100 rounded-lg"></div>
      </div>
    </div>
  </div>
</section>
