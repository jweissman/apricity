<section class="space-y-10">
  <!-- Pipelines Section -->
  <div class="card-elevated rounded-2xl border border-slate-200/50 p-8">
    <div class="flex items-center justify-between mb-8">
      <h2 class="text-lg font-semibold text-slate-800 flex items-center">
        <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-sky-400 to-blue-500 flex items-center justify-center mr-3 shadow-md shadow-sky-500/15">
          <i class="fas fa-sitemap text-white text-xs"></i>
        </div>
        Pipelines
      </h2>
      <span class="text-xs text-slate-500 bg-slate-100/80 px-3 py-1.5 rounded-full font-medium"><%= @pipelines.size %> configured</span>
    </div>

    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      <% @pipelines.each do |pipeline| %>
        <div class="group relative bg-white rounded-2xl border border-slate-200/60 p-6 card-hover transition-all duration-200 hover:border-sky-300">
          <div class="flex items-start justify-between mb-5">
            <div>
              <h3 class="font-semibold text-slate-800 group-hover:text-sky-700 transition-colors duration-200"><%= pipeline.name %></h3>
              <p class="text-xs text-slate-500 mt-2 flex items-center gap-3">
                <span class="inline-flex items-center px-2.5 py-1 rounded-lg bg-slate-100/80 text-slate-600">
                  <i class="fas fa-layer-group mr-1.5 text-slate-400 text-[10px]"></i>
                  <%= pipeline.actions.size %>
                </span>
                <span class="text-slate-400">·</span>
                <span class="text-slate-500"><%= pipeline.total_steps %> steps</span>
              </p>
            </div>
            <form action="/pipelines/<%= pipeline.slug %>/run" method="post" class="inline">
              <button 
                type="submit" 
                class="w-11 h-11 rounded-full bg-gradient-to-br from-emerald-400 to-teal-500 hover:from-emerald-500 hover:to-teal-600 text-white flex items-center justify-center transition-all duration-200 shadow-lg shadow-emerald-500/20 hover:shadow-emerald-500/35 hover:scale-105 active:scale-95 cursor-pointer"
                title="Run pipeline"
              >
                <i class="fas fa-play text-xs ml-0.5"></i>
              </button>
            </form>
          </div>
          <a
            href="/pipelines/<%= pipeline.slug %>"
            class="text-sm text-sky-600 hover:text-sky-700 font-medium transition-colors duration-200 inline-flex items-center group/link cursor-pointer"
          >
            View details 
            <i class="fas fa-arrow-right ml-2 text-xs group-hover/link:translate-x-1 transition-transform duration-200"></i>
          </a>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Recent Runs Section -->
  <div class="card-elevated rounded-2xl border border-slate-200/50 p-8">
    <div class="flex items-center justify-between mb-8">
      <h2 class="text-lg font-semibold text-slate-800 flex items-center">
        <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-indigo-400 to-violet-500 flex items-center justify-center mr-3 shadow-md shadow-indigo-500/15">
          <i class="fas fa-history text-white text-xs"></i>
        </div>
        Recent Runs
      </h2>
      <div class="flex items-center space-x-3">
        <select id="status-filter" class="text-sm border border-slate-200 rounded-xl px-4 py-2.5 bg-white shadow-sm focus:ring-2 focus:ring-sky-500/20 focus:border-sky-400 transition-all duration-200 text-slate-600">
          <option value="all">All Status</option>
          <option value="running">Running</option>
          <option value="success">Passed</option>
          <option value="failure">Failed</option>
        </select>
      </div>
    </div>

    <div
      hx-get="/runs"
      hx-trigger="load"
      hx-target="#job-list"
      hx-swap="innerHTML"
    ></div>

    <div id="job-list">
      <div class="space-y-4">
        <div class="h-20 bg-gradient-to-r from-slate-100/80 to-slate-50/50 rounded-2xl animate-pulse flex items-center px-6">
          <div class="w-12 h-12 bg-slate-200/60 rounded-full"></div>
          <div class="ml-5 space-y-3 flex-1">
            <div class="h-4 bg-slate-200/60 rounded-lg w-1/3"></div>
            <div class="h-3 bg-slate-200/40 rounded-lg w-1/4"></div>
          </div>
        </div>
        <div class="h-20 bg-gradient-to-r from-slate-100/80 to-slate-50/50 rounded-2xl animate-pulse flex items-center px-6">
          <div class="w-12 h-12 bg-slate-200/60 rounded-full"></div>
          <div class="ml-5 space-y-3 flex-1">
            <div class="h-4 bg-slate-200/60 rounded-lg w-2/5"></div>
            <div class="h-3 bg-slate-200/40 rounded-lg w-1/5"></div>
          </div>
        </div>
        <div class="h-20 bg-gradient-to-r from-slate-100/80 to-slate-50/50 rounded-2xl animate-pulse flex items-center px-6">
          <div class="w-12 h-12 bg-slate-200/60 rounded-full"></div>
          <div class="ml-5 space-y-3 flex-1">
            <div class="h-4 bg-slate-200/60 rounded-lg w-1/4"></div>
            <div class="h-3 bg-slate-200/40 rounded-lg w-1/6"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
