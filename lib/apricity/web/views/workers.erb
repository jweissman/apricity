<!-- all job leases -->
<div class="bg-white rounded-xl border border-frost-200 p-6 mb-6">
  <div class="flex items-center justify-between mb-6">
    <h2 class="text-base font-semibold text-frost-800 flex items-center gap-2">
      <i class="fas fa-tasks text-frost-400"></i>
      Active Job Leases
    </h2>
  </div>

  <% if @leases.any? %>
    <div class="space-y-2">
      <% @leases.each do |lease| %>
        <div class="block" data-lease-id="<%= lease['run_id'] %>">
          <div
            class="
              flex items-center justify-between p-4 bg-white rounded-xl
              border border-frost-200/60 hover:border-sun-300
              hover:bg-sun-50/30 transition-all duration-200
            "
          >
            <div class="flex items-center space-x-4">
              <div
                class="
                  w-10 h-10 rounded-lg flex items-center justify-center
                  bg-amber-50
                "
              >
                <i class="fas fa-tasks text-amber-600"></i>
              </div>

              <div>
                <div class="font-medium text-frost-800">
                  <a href="/runs/<%= lease[:run_id] %>" class="text-sun-600 hover:text-sun-700 font-medium transition-colors">
                    Run: <%= lease[:run_id][0..7] %>
                  </a>
                </div>

                <div class="text-xs text-frost-400 font-mono mt-0.5">
                  Worker: <%= lease[:worker_id] %>
                </div>

                <div class="text-xs text-frost-500 mt-1">
                  <a href="/pipelines/<%= lease[:pipeline_slug] %>" class="text-sun-600 hover:text-sun-700 font-medium transition-colors">
                    View Pipeline →
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-16">
      <div
        class="
          w-24 h-24 mx-auto mb-5 rounded-2xl bg-gradient-to-br from-sun-100
          to-sun-200 flex items-center justify-center shadow-inner
        "
      >
        <i class="fas fa-tasks text-4xl text-sun-500"></i>
      </div>

      <h3 class="text-lg font-semibold text-frost-700 mb-2">
        No Active Job Leases
      </h3>

      <p class="text-frost-500 text-sm mb-5">
        Workers are not currently processing any jobs
      </p>

      <a
        href="/"
        class="
          inline-flex items-center px-5 py-2.5 bg-gradient-to-r from-sun-400
          to-sun-500 hover:from-sun-500 hover:to-sun-600 text-white
          text-sm font-medium rounded-xl transition-all duration-200
          shadow-lg shadow-sun-500/20
        "
      >
        <i class="fas fa-arrow-left mr-2"></i>
        Back to Dashboard
      </a>
    </div>
  <% end %>
</div>

<!-- all known workers -->
<div class="bg-white rounded-xl border border-frost-200 p-6 mb-6">
  <div class="flex items-center justify-between mb-6">
    <h2 class="text-base font-semibold text-frost-800 flex items-center gap-2">
      <i class="fas fa-server text-frost-400"></i>
      Active Workers
    </h2>
  </div>

  <% if @workers.any? %>
    <div class="space-y-2">
      <% @workers.each do |worker| %>
        <div class="block" data-worker-id="<%= worker['worker_id'] %>">
          <div
            class="
              flex items-center justify-between p-4 bg-white rounded-xl
              border border-frost-200/60 hover:border-sun-300
              hover:bg-sun-50/30 transition-all duration-200
            "
          >
            <div class="flex items-center space-x-4">
              <div
                class="
                  w-10 h-10 rounded-lg flex items-center justify-center
                  bg-emerald-50
                "
              >
                <i class="fas fa-server text-emerald-600"></i>
              </div>

              <div>
                <div class="font-medium text-frost-800">
                  <%= worker['worker_id'][0..7] %>
                </div>

                <div class="text-xs text-frost-400 font-mono mt-0.5">
                  PID: <%= worker['pid'] %> • v<%= worker['version'] %>
                </div>

                <div class="text-xs text-frost-500 mt-1">
                  <% if worker['current_run_id'] && worker['current_pipeline_slug'] %>
                    Processing run
                    <span class="font-mono"><%= worker['current_run_id'][0..7] %></span>
                    of pipeline
                    <span class="font-mono"><%= worker['current_pipeline_slug'] %></span>

                    <a href="/runs/<%= worker['current_run_id'] %>" class="text-sun-600 hover:text-sun-700 font-medium ml-2 transition-colors">
                      View Run →
                    </a>
                  <% else %>
                    Idle
                  <% end %>
                </div>
              </div>
            </div>

            <div class="text-right">
              <div class="text-xs text-frost-500">
                <% if worker['started_at'] %>
                  Started:
                  <%= Time.at(worker['started_at'].to_i).strftime("%b %d, %H:%M") %>
                <% else %>
                  <span class="text-frost-400">Unknown</span>
                <% end %>
              </div>

              <div class="text-xs mt-1 text-frost-500">
                <% if worker['last_seen_at'] %>
                  Last seen at:
                  <%= Time.at(worker['last_seen_at'].to_i).strftime("%b %d, %H:%M") %>
                  (
                  <%= Time.now.to_i - worker['last_seen_at'].to_i %> seconds ago
                  )
                <% else %>
                  <span class="text-frost-400">No heartbeat</span>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-16">
      <div
        class="
          w-24 h-24 mx-auto mb-5 rounded-2xl bg-gradient-to-br from-sun-100
          to-sun-200 flex items-center justify-center shadow-inner
        "
      >
        <i class="fas fa-server text-4xl text-sun-500"></i>
      </div>

      <h3 class="text-lg font-semibold text-frost-700 mb-2">
        No Workers Running
      </h3>

      <p class="text-frost-500 text-sm mb-5">
        Start a worker to begin processing pipeline runs
      </p>

      <a
        href="/"
        class="
          inline-flex items-center px-5 py-2.5 bg-gradient-to-r from-sun-400
          to-sun-500 hover:from-sun-500 hover:to-sun-600 text-white
          text-sm font-medium rounded-xl transition-all duration-200
          shadow-lg shadow-sun-500/20
        "
      >
        <i class="fas fa-arrow-left mr-2"></i>
        Back to Dashboard
      </a>
    </div>
  <% end %>
</div>
