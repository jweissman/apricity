<% if @runs.any? %>
  <div class="space-y-3">
    <% @runs.reverse.first(10).each do |run| %>
      <a href="/runs/<%= run.id %>" class="block">
        <div class="flex items-center justify-between p-4 bg-gray-800/50 rounded-lg border border-gray-700 hover:border-gray-600 transition-all card-hover">
          <div class="flex items-center space-x-4">
            <div class="text-xl">
              <%= pretty_status(run.status) %>
            </div>
            <div>
              <div class="font-medium text-gray-800"><%= run.pipeline.name %></div>
              <div class="text-xs text-gray-500 font-mono mt-0.5">
                <%= run.id[0..7] %>...
              </div>
            </div>
          </div>
          <div class="text-right">
            <div class="text-xs text-gray-400">
              <% if run.started_at %>
                <%= run.started_at.strftime("%b %d, %H:%M:%S") %>
              <% else %>
                Pending
              <% end %>
            </div>
            <div class="text-xs text-gray-500 mt-1">
              <% if run.status == :running %>
                <span class="text-yellow-400 animate-pulse-subtle">
                  <i class="fas fa-circle text-xs mr-1"></i>Running
                </span>
              <% elsif run.status == :success %>
                <span class="text-green-400">Passed</span>
              <% elsif run.status == :failure %>
                <span class="text-red-400">Failed</span>
              <% else %>
                <span class="text-gray-400"><%= run.status %></span>
              <% end %>
            </div>
          </div>
        </div>
      </a>
    <% end %>
  </div>
<% else %>
  <div class="text-center py-12 text-gray-500">
    <i class="fas fa-inbox text-4xl mb-3 opacity-50"></i>
    <p>No runs yet. Start a pipeline to see results here.</p>
  </div>
<% end %>
