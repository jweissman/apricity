<% if @runs.any? %>
  <div class="space-y-3">
    <% @runs.each do |run| %>
      <a href="/runs/<%= run.id %>" class="block group" data-status="<%= run.status %>">
        <div class="flex items-center justify-between p-4 bg-white rounded-xl border border-frost-200/60 hover:border-sun-300 hover:bg-sun-50/30 transition-all duration-200">
          <div class="flex items-center space-x-4">
            <div class="w-10 h-10 rounded-lg flex items-center justify-center <%= run.status == 'running' ? 'bg-amber-50' : run.status == 'success' ? 'bg-emerald-50' : run.status == 'failure' ? 'bg-red-50' : 'bg-frost-100' %>">
              <% if run.status == 'running' %>
                <i class="fas fa-circle-notch fa-spin text-amber-600"></i>
              <% elsif run.status == 'success' %>
                <i class="fas fa-check text-emerald-600"></i>
              <% elsif run.status == 'failure' %>
                <i class="fas fa-times text-red-500"></i>
              <% else %>
                <i class="far fa-clock text-frost-400"></i>
              <% end %>
            </div>
            <div>
              <div class="font-medium text-frost-800 group-hover:text-sun-700 transition-colors"><%= run.pipeline_name %></div>
              <div class="text-xs text-frost-400 font-mono mt-0.5"><%= run.id[0..7] %></div>
            </div>
          </div>
          <div class="text-right">
            <div class="text-xs text-frost-500">
              <% if run.started_at %>
                <%= run.started_at.strftime("%b %d, %H:%M") %>
              <% else %>
                <span class="text-frost-400">Queued</span>
              <% end %>
            </div>
            <div class="text-xs mt-1 font-medium <%= run.status == 'running' ? 'text-amber-600' : run.status == 'success' ? 'text-emerald-600' : run.status == 'failure' ? 'text-red-600' : 'text-frost-500' %>">
              <%= run.status == 'running' ? 'Running' : run.status == 'success' ? 'Passed' : run.status == 'failure' ? 'Failed' : run.status&.capitalize %>
            </div>
          </div>
        </div>
      </a>
    <% end %>
  </div>
<% else %>
  <div class="text-center py-16">
    <div class="w-24 h-24 mx-auto mb-5 rounded-2xl bg-gradient-to-br from-sun-100 to-sun-200 flex items-center justify-center shadow-inner">
      <i class="fas fa-rocket text-4xl text-sun-500"></i>
    </div>
    <h3 class="text-lg font-semibold text-frost-700 mb-2">No Pipeline Runs Yet</h3>
    <p class="text-frost-500 text-sm mb-5">Get started by running a pipeline from the dashboard</p>
  </div>
<% end %>
