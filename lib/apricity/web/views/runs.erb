<% if @runs.any? %>
  <div class="space-y-2">
    <% @runs.reverse.first(10).each do |run| %>
      <a href="/runs/<%= run.id %>" class="block group">
        <div class="flex items-center justify-between p-4 bg-gray-50 rounded-lg border border-gray-200 hover:border-blue-300 hover:bg-blue-50/50 hover:shadow-md transition-all duration-200">
          <div class="flex items-center space-x-4">
            <div class="text-2xl">
              <%= pretty_status(run.status) %>
            </div>
            <div>
              <div class="font-semibold text-gray-900 group-hover:text-blue-700 transition-colors"><%= run.pipeline.name %></div>
              <div class="text-xs text-gray-400 font-mono mt-0.5 flex items-center">
                <i class="fas fa-fingerprint mr-1.5 text-gray-300"></i>
                <%= run.id[0..7] %>...
              </div>
            </div>
          </div>
          <div class="text-right">
            <div class="text-xs text-gray-500">
              <% if run.started_at %>
                <i class="far fa-clock mr-1"></i><%= run.started_at.strftime("%b %d, %H:%M:%S") %>
              <% else %>
                <span class="text-gray-400">Pending</span>
              <% end %>
            </div>
            <div class="text-xs mt-1.5">
              <% if run.status == :running %>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full bg-amber-100 text-amber-700 font-medium animate-pulse-subtle">
                  <i class="fas fa-circle-notch fa-spin text-xs mr-1"></i>Running
                </span>
              <% elsif run.status == :success %>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-700 font-medium">
                  <i class="fas fa-check mr-1"></i>Passed
                </span>
              <% elsif run.status == :failure %>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full bg-red-100 text-red-700 font-medium">
                  <i class="fas fa-times mr-1"></i>Failed
                </span>
              <% else %>
                <span class="text-gray-500"><%= run.status %></span>
              <% end %>
            </div>
          </div>
        </div>
      </a>
    <% end %>
  </div>
<% else %>
  <div class="text-center py-12">
    <div class="w-20 h-20 mx-auto mb-4 rounded-full bg-gradient-to-br from-blue-100 to-indigo-100 flex items-center justify-center">
      <i class="fas fa-rocket text-3xl text-blue-500"></i>
    </div>
    <h3 class="text-lg font-semibold text-gray-700 mb-2">No Pipeline Runs Yet</h3>
    <p class="text-gray-500 text-sm mb-4">Get started by running a pipeline from the dashboard</p>
    <a href="/" class="inline-flex items-center px-4 py-2 bg-blue-500 hover:bg-blue-600 text-white text-sm font-medium rounded-lg transition-colors">
      <i class="fas fa-arrow-left mr-2"></i>
      Back to Dashboard
    </a>
  </div>
<% end %>
