<% if @runs.any? %>
  <div class="space-y-3">
    <% @runs.reverse.first(10).each do |run| %>
      <a href="/runs/<%= run.id %>" class="block group">
        <div class="flex items-center justify-between p-5 bg-white rounded-2xl border border-slate-200/60 hover:border-sky-200 hover:shadow-md hover:shadow-sky-100/50 transition-all duration-300">
          <div class="flex items-center space-x-4">
            <div class="text-2xl">
              <%= pretty_status(run.status) %>
            </div>
            <div>
              <div class="font-semibold text-slate-800 group-hover:text-sky-700 transition-colors duration-200"><%= run.pipeline.name %></div>
              <div class="text-xs text-slate-400 font-mono mt-1 flex items-center">
                <i class="fas fa-fingerprint mr-1.5 text-slate-300"></i>
                <%= run.id[0..7] %>...
              </div>
            </div>
          </div>
          <div class="text-right">
            <div class="text-xs text-slate-500">
              <% if run.started_at %>
                <i class="far fa-clock mr-1.5 text-slate-400"></i><%= run.started_at.strftime("%b %d, %H:%M:%S") %>
              <% else %>
                <span class="text-slate-400">Pending</span>
              <% end %>
            </div>
            <div class="text-xs mt-2">
              <% if run.status == :running %>
                <span class="inline-flex items-center px-3 py-1 rounded-full bg-gradient-to-r from-amber-50 to-orange-50 text-amber-600 font-medium border border-amber-200/60 animate-pulse-subtle">
                  <i class="fas fa-circle-notch fa-spin text-xs mr-1.5"></i>Running
                </span>
              <% elsif run.status == :success %>
                <span class="inline-flex items-center px-3 py-1 rounded-full bg-gradient-to-r from-emerald-50 to-teal-50 text-emerald-600 font-medium border border-emerald-200/60">
                  <i class="fas fa-check mr-1.5"></i>Passed
                </span>
              <% elsif run.status == :failure %>
                <span class="inline-flex items-center px-3 py-1 rounded-full bg-gradient-to-r from-rose-50 to-red-50 text-rose-600 font-medium border border-rose-200/60">
                  <i class="fas fa-times mr-1.5"></i>Failed
                </span>
              <% else %>
                <span class="text-slate-500"><%= run.status %></span>
              <% end %>
            </div>
          </div>
        </div>
      </a>
    <% end %>
  </div>
<% else %>
  <div class="text-center py-16">
    <div class="w-24 h-24 mx-auto mb-5 rounded-2xl bg-gradient-to-br from-sky-100 to-blue-100 flex items-center justify-center shadow-inner">
      <i class="fas fa-rocket text-4xl text-sky-400"></i>
    </div>
    <h3 class="text-lg font-semibold text-slate-700 mb-2">No Pipeline Runs Yet</h3>
    <p class="text-slate-500 text-sm mb-5">Get started by running a pipeline from the dashboard</p>
    <a href="/" class="inline-flex items-center px-5 py-2.5 bg-gradient-to-r from-sky-400 to-blue-500 hover:from-sky-500 hover:to-blue-600 text-white text-sm font-medium rounded-xl transition-all duration-200 shadow-lg shadow-sky-500/20">
      <i class="fas fa-arrow-left mr-2"></i>
      Back to Dashboard
    </a>
  </div>
<% end %>
