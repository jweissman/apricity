<!-- Breadcrumb -->
<nav class="mb-6 flex items-center text-sm text-slate-500">
  <a href="/" class="hover:text-sky-600 transition-colors">Dashboard</a>
  <i class="fas fa-chevron-right mx-2 text-slate-300 text-xs"></i>
  <a href="/pipelines/<%= @pipeline.slug %>" class="hover:text-sky-600 transition-colors"><%= @pipeline.name %></a>
  <i class="fas fa-chevron-right mx-2 text-slate-300 text-xs"></i>
  <span class="text-slate-700 font-medium">Run <%= @run.id[0..7] %></span>
</nav>

<!-- Run Header Card -->
<div class="bg-white rounded-xl border border-slate-200 p-6 mb-6">
  <div class="flex items-start justify-between">
    <div class="space-y-3">
      <div class="flex items-center gap-3">
        <h1 class="text-xl font-semibold text-slate-800"><%= @pipeline.name %></h1>
        <div id="run-status">
          <span class="inline-flex items-center gap-2 text-xs px-3 py-1.5 rounded-full border font-medium bg-slate-50 text-slate-600 border-slate-200">
            <span class="w-2 h-2 rounded-full bg-slate-300 animate-pulse"></span>
            Loading
          </span>
        </div>
      </div>
      
      <div class="flex items-center gap-4 text-sm">
        <span class="text-slate-500 font-mono text-xs bg-slate-100 px-2 py-1 rounded" title="Run ID">
          <%= @run.id[0..7] %>
        </span>
        <span class="text-slate-400">·</span>
        <span class="text-slate-600">
          <%= @run.start_time.strftime("%b %d, %Y at %H:%M") %>
        </span>
        <span id="run-duration" class="text-slate-600 font-medium hidden">
          <!-- Duration will be populated by JS -->
        </span>
      </div>
    </div>
    
    <div class="flex items-center gap-2">
      <!-- Future: Add retry/cancel buttons here -->
    </div>
  </div>
</div>

<!-- Pipeline Annotations (hidden until populated) -->
<div id="annotations-list" class="hidden mb-6"></div>

<!-- Pipeline DAG -->
<div class="mb-6 bg-white rounded-xl border border-slate-200 overflow-hidden">
  <div class="px-5 py-3 border-b border-slate-100 bg-slate-50/50">
    <h2 class="text-xs font-medium text-slate-500 uppercase tracking-wide flex items-center gap-2">
      <i class="fas fa-sitemap text-slate-400"></i>
      Pipeline Flow
    </h2>
  </div>
  <div id="dag-container" class="flex justify-center p-4 bg-gradient-to-b from-slate-50/50 to-white"></div>
</div>

<!-- Jobs Section -->
<div class="bg-white rounded-xl border border-slate-200 p-6">
  <div id="job-list"></div>
</div>


<script>
  window.ApricityRun = {
    id: "<%= @run.id %>",
    pipeline: "<%= @pipeline.name %>",
    eventsUrl: "/runs/<%= @run.id %>/events",
    dag: <%= dag_data(@pipeline) %>
  };
</script>

<script src="/assets/run/index.js" type="module"></script>
