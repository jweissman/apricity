<div class="mb-6">
  <a href="/" class="text-sm text-gray-500 hover:text-gray-700 transition-colors">
    <i class="fas fa-arrow-left mr-2"></i>Back to Dashboard
  </a>
</div>

<div class="flex items-center justify-between mb-6">
  <div>
    <h2 class="text-2xl font-bold text-gray-800"><%= @pipeline.name %></h2>
    <div class="flex items-center space-x-4 mt-2">
      <p class="text-sm text-gray-500 font-mono flex items-center">
        <i class="fas fa-fingerprint mr-2 text-gray-400"></i>
        <%= @run.id[0..7] %>...
      </p>
      <% if @run.git_sha %>
        <p class="text-sm text-gray-500 font-mono flex items-center">
          <i class="fab fa-git-alt mr-2 text-gray-400"></i>
          <%= @run.git_sha[0..7] %>
        </p>
      <% end %>
      <p class="text-sm text-gray-500 flex items-center">
        <i class="far fa-clock mr-2 text-gray-400"></i>
        <%= @run.start_time.strftime("%b %d, %H:%M:%S") %>
      </p>
    </div>
  </div>
  <div id="run-status" class="px-4 py-2">
    <span class="text-sm text-gray-400">Status loading...</span>
  </div>
</div>

<div id="annotations-list" class="space-y-2 hidden mb-6">
  <div class="text-gray-400">No annotations available.</div>
</div>

<!-- Pipeline DAG -->
<div class="mb-6 bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
  <div class="px-6 py-4 border-b border-gray-100 bg-gradient-to-r from-blue-50 to-indigo-50">
    <h3 class="text-sm font-semibold text-gray-700 uppercase tracking-wide flex items-center">
      <i class="fas fa-project-diagram mr-2 text-blue-500"></i>
      Pipeline Flow
    </h3>
  </div>
  <div id="dag-container" class="flex justify-center p-2"></div>
</div>

<div class="layout">
  <div id="job-list" class="bg-white rounded-xl border border-gray-200 shadow-sm p-6"></div>
</div>


<script>
  window.ApricityRun = {
    id: "<%= @run.id %>",
    pipeline: "<%= @pipeline.name %>",
    eventsUrl: "/runs/<%= @run.id %>/events",
    dag: <%= dag_data(@pipeline) %>
  };
</script>

<script src="/assets/run/index.js" type="module"></script>
