<div class="mb-6">
  <a href="/" class="text-sm text-gray-500 hover:text-gray-300 transition-colors">
    <i class="fas fa-arrow-left mr-2"></i>Back to Dashboard
  </a>
</div>

<div class="flex items-center justify-between mb-6">
  <div>
    <h2 class="text-2xl font-bold text-gray-800"><%= @pipeline.name %></h2>
    <p class="text-sm text-gray-500 font-mono mt-1">Run <%= @run.id[0..7] %>...</p>
  </div>
  <div id="run-status" class="px-4 py-2">
    <span class="text-sm text-gray-400">Status loading...</span>
  </div>
</div>

<!-- Pipeline DAG -->
<div class="mb-6 p-4 bg-white rounded-xl border border-gray-200 shadow-sm">
  <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-3">Pipeline</h3>
  <pre class="mermaid text-center">
<%= mermaid_dag(@pipeline) %>
  </pre>
</div>

<div class="layout">
  <div id="job-list" class="bg-gray-900/50 rounded-xl border border-gray-800 p-4"></div>
</div>


<script>
  window.ApricityRun = {
    id: "<%= @run.id %>",
    pipeline: "<%= @pipeline.name %>",
    eventsUrl: "/runs/<%= @run.id %>/events"
  };
</script>

<script src="/assets/run/index.js" type="module"></script>
